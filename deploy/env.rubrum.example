# /root/sorametrics-v33/.env on Rubrum-01 — copy, fill the two secrets, chmod 600.
# Variable meanings: see .env.example at the repo root.

DATABASE_URL=postgres://sorametrics:<POSTGRES_PASSWORD>@127.0.0.1:5432/sorametrics_v33
# Throwaway copy of the Node's tables for the one-off ETL (deploy/transfer_legacy.sh).
LEGACY_DATABASE_URL=postgres://sorametrics:<POSTGRES_PASSWORD>@127.0.0.1:5432/legacy_copy

# Two local validators. The ingest and the API get the OPPOSITE primary
# (set per process in deploy/ecosystem.v33.config.js); mof2 is the last resort.
WS_ENDPOINTS=ws://127.0.0.1:9944,wss://mof2.sora.org
# Archive node for historical quotes and era decoding (both local nodes are pruned).
PRICE_ARCHIVE_RPC=wss://mof2.sora.org
# API reads at historical blocks (/block/:n, governance preimage scans); the Node's default.
ARCHIVE_WS_ENDPOINT=wss://mof2.sora.org

API_BIND=127.0.0.1:3311
API_TIME_ZONE=Europe/Madrid
CORS_ORIGINS=https://sorametrics.org,https://www.sorametrics.org

STATIC_DIR=/root/sorametrics-static
MUSIC_DIR=/root/sorametrics-media/music
NEWS_DIR=/root/sorametrics-media/news

HOLDERS_PREWARM_SECS=240
ANALYTICS_SALT=<random 32+ chars>
ANALYTICS_RAW_RETENTION_DAYS=30

MINAMOTO_TORII=https://minamoto.sora.org
SUBSTRATE_GAP_CONCURRENCY=16
SUBSTRATE_LAG_ALERT_BLOCKS=20
PRICE_SAMPLE_INTERVAL_SECS=60
PRICE_SWEEP_INTERVAL_SECS=600
SUPPLY_SNAPSHOT_INTERVAL_SECS=1800
RUST_LOG=info
