  "query": "\n        SELECT a.definition_id, a.account_id, a.value::TEXT AS \"value!\", a.updated_at, d.alias, d.name\n        FROM mn.assets a\n        LEFT JOIN mn.asset_definitions d ON d.id = a.definition_id\n        ORDER BY a.updated_at DESC LIMIT $1 OFFSET $2\n        ",
