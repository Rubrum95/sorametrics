  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            block_height,\n            extrinsic_id,\n            event_id,\n            hash,\n            block_timestamp,\n            from_address,\n            to_address,\n            asset_id,\n            amount    AS \"amount!: BigDecimal\",\n            usd_value AS \"usd_value: BigDecimal\"\n        FROM sm.transfers\n        WHERE (block_height, event_id) < ($1, $2)\n        ORDER BY block_height DESC, event_id DESC\n        LIMIT $3 OFFSET $4\n        ",
