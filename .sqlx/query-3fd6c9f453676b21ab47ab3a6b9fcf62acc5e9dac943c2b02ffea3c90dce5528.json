  "query": "\n        SELECT block_height, extrinsic_id, hash, block_timestamp, caller,\n               input_asset_id, input_amount, output_asset_id, output_amount,\n               usd_value, output_usd_value\n        FROM sm.swaps\n        WHERE block_height > $1\n        ORDER BY block_height, event_id\n        LIMIT $2\n        ",
