  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            block_height,\n            extrinsic_id,\n            event_id,\n            block_timestamp,\n            direction::text AS \"direction!\",\n            network,\n            caller,\n            asset_id,\n            amount AS \"amount!: BigDecimal\"\n        FROM sm.live_bridges\n        WHERE caller = $1\n        ORDER BY block_height DESC, event_id DESC\n        LIMIT $2 OFFSET $3\n        ",
