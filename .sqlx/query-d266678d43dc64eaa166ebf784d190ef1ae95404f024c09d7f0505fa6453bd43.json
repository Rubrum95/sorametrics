{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            block_height,\n            extrinsic_id,\n            event_id,\n            hash,\n            block_timestamp,\n            caller,\n            input_asset_id,\n            input_amount  AS \"input_amount!: BigDecimal\",\n            output_asset_id,\n            output_amount AS \"output_amount!: BigDecimal\",\n            usd_value     AS \"usd_value: BigDecimal\"\n        FROM sm.swaps\n        WHERE caller = $1 AND (block_height, event_id) < ($2, $3)\n        ORDER BY block_height DESC, event_id DESC\n        LIMIT $4 OFFSET $5\n        ",
