  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            block_height,\n            extrinsic_id,\n            event_id,\n            block_timestamp,\n            from_address,\n            to_address,\n            asset_id,\n            amount    AS \"amount!: BigDecimal\",\n            usd_value AS \"usd_value: BigDecimal\"\n        FROM sm.live_transfers\n        WHERE from_address = $1 OR to_address = $1\n        ORDER BY block_height DESC, event_id DESC\n        LIMIT $2 OFFSET $3\n        ",
