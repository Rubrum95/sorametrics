# SoraMetrics v33 — environment variables (dev defaults)
# Copy to .env and adjust.

# ---- PostgreSQL + TimescaleDB ----
# Matches docker-compose.dev.yml
DATABASE_URL=postgres://sorametrics:sorametrics_dev@localhost:5432/sorametrics_v33

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- API server ----
API_BIND=127.0.0.1:3001
# IANA zone for the legacy `time` strings (the Node ran on a Madrid clock).
API_TIME_ZONE=Europe/Madrid
# Comma-separated CORS origins. Empty = no CORS allowed.
CORS_ORIGINS=

# ---- Substrate (SORA v2) RPC ----
# Comma-separated WS endpoints, primary first.
WS_ENDPOINTS=ws://127.0.0.1:9944,wss://ws.mof.sora.org,wss://mof2.sora.org
# Popular-asset price sampler period (Node legacy: 60 s).
PRICE_SAMPLE_INTERVAL_SECS=60
# Full whitelist price sweep period (feeds /tokens for non-popular assets).
PRICE_SWEEP_INTERVAL_SECS=600
# MOF circulating-supply snapshots (sm.supply_snapshots), seconds. Node: 30 min.
SUPPLY_SNAPSHOT_INTERVAL_SECS=1800
# Blocks decoded in parallel when filling the gap after a reconnect (RPC-bound).
SUBSTRATE_GAP_CONCURRENCY=16
# Warn when the live cursor is more than N blocks behind the finalized head;
# exit for a supervisor restart when it also stops moving (3 probes).
SUBSTRATE_LAG_ALERT_BLOCKS=20

# ---- Iroha 3 (Minamoto) Torii ----
# `sorametrics-ingest --source iroha` and the /api/minamoto/* passthroughs.
# For a local stand-in while minamoto.sora.org is down: scripts/torii_mock.py.
MINAMOTO_TORII=https://minamoto.sora.org
# HTTP policy (the Node's minamoto/config.js defaults).
MINAMOTO_HTTP_TIMEOUT_MS=10000
MINAMOTO_HTTP_RETRY_MAX=2
MINAMOTO_HTTP_RETRY_DELAY_MS=500
MINAMOTO_HTTP_CACHE_TTL_MS=5000

# Polling intervals (ms), the Node's defaults.
MINAMOTO_POLL_NETWORK_MS=10000
MINAMOTO_POLL_BLOCKS_MS=30000
MINAMOTO_POLL_TX_MS=30000
MINAMOTO_POLL_ACCOUNTS_MS=300000
MINAMOTO_POLL_DOMAINS_MS=300000
MINAMOTO_POLL_ASSETS_MS=300000
MINAMOTO_POLL_PEERS_MS=60000
MINAMOTO_POLL_PROM_MS=60000
# Prometheus snapshot retention (days) and cleanup period (ms).
MINAMOTO_METRICS_RETENTION_DAYS=30
MINAMOTO_METRICS_CLEANUP_MS=3600000
# Cursor pages (100 rows each) the boot backfill walks at most per feed.
MINAMOTO_BACKFILL_MAX_PAGES=400

# ---- Telemetry ----
# Levels: trace, debug, info, warn, error. Per-target filters supported.
RUST_LOG=info,sorametrics_ingest=debug,sorametrics_api=debug

# Static media served by the API (the Node's express.static): radio
# tracks at /music and news media at /news. Unset = not mounted.
# MUSIC_DIR=/root/sorametrics/music
# NEWS_DIR=/root/sorametrics/news
