# ============================================================
# SoraMetrics — environment variables
# Copy to .env and fill in your values.
# ============================================================

# ---- Server ----
PORT=3000
CORS_ORIGINS=

# ---- SORA v2 (Substrate) RPC ----
# Comma-separated WS endpoints (failover order). First is primary.
WS_ENDPOINTS=ws://127.0.0.1:9944,wss://ws.mof.sora.org,wss://mof2.sora.org
# Single endpoint variants used in some legacy paths
WS_ENDPOINT=wss://ws.mof.sora.org
WS_ENDPOINT_BACKFILL=wss://mof2.sora.org
ARCHIVE_WS_ENDPOINT=wss://mof2.sora.org

# ---- Ethereum RPC (for Hashi v2 bridge indexer) ----
ETH_RPC_URL=

# ---- PostgreSQL (sora-subsquid container) ----
PG_HOST=127.0.0.1
PG_PORT=23798
PG_USER=postgres
PG_PASS=
PG_DB=squid

# ---- Whitelist (token registry) ----
WHITELIST_URL=https://raw.githubusercontent.com/sora-xor/polkaswap-token-whitelist-config/master/whitelist.json

# ============================================================
# Minamoto (SORA Nexus / Iroha 3) — only needed for /minamoto
# ============================================================
MINAMOTO_TORII=https://minamoto.sora.org

# HTTP client tuning
MINAMOTO_HTTP_TIMEOUT_MS=10000
MINAMOTO_HTTP_RETRY_MAX=3
MINAMOTO_HTTP_RETRY_DELAY_MS=500
MINAMOTO_HTTP_CACHE_TTL_MS=5000

# Indexer poll intervals (ms)
MINAMOTO_POLL_NETWORK_MS=10000
MINAMOTO_POLL_BLOCKS_MS=15000
MINAMOTO_POLL_TX_MS=15000
MINAMOTO_POLL_ACCOUNTS_MS=60000
MINAMOTO_POLL_DOMAINS_MS=300000
MINAMOTO_POLL_ASSETS_MS=300000
MINAMOTO_POLL_PEERS_MS=30000
MINAMOTO_POLL_PROM_MS=15000

# Metrics retention (days) and cleanup interval (ms)
MINAMOTO_METRICS_RETENTION_DAYS=30
MINAMOTO_METRICS_CLEANUP_MS=3600000

# Postgres pool size for Minamoto
MINAMOTO_PG_MAX=10
